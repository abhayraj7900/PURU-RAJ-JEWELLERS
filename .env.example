# Supabase Edge Function secrets. Add real values only to a local .env file or Supabase Secrets.
SITE_URL=https://triptijewllers.vercel.app
ALLOWED_ORIGINS=https://triptijewllers.vercel.app,http://127.0.0.1:8765,http://localhost:8765

# Razorpay payment gateway
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Shiprocket API user and pickup location
SHIPROCKET_EMAIL=replace_me
SHIPROCKET_PASSWORD=replace_me
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPMENT_LENGTH_CM=10
SHIPMENT_BREADTH_CM=10
SHIPMENT_HEIGHT_CM=5
SHIPMENT_WEIGHT_KG=0.5

# Resend transactional email
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Tripti Jewellers <orders@your-domain.com>
ADMIN_NOTIFICATION_EMAIL=triptijewellers4826@gmail.com

# MSG91 transactional SMS
MSG91_AUTH_KEY=replace_me
MSG91_TEMPLATE_ID=replace_me
MSG91_ADMIN_MOBILE=91XXXXXXXXXX

